{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chise-api",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
